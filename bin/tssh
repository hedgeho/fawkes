#!/usr/bin/env bash
#
# tssh — connection-safe wrapper for Triton cluster access. RUNS ON THE LOCAL
# machine only (it drives the local SSH client / control socket; it is useless
# and never invoked on the cluster clone).
#
# ── Why this exists ──────────────────────────────────────────────────────────
# The Aalto gateways (kosh / brute) require ssh-key **and** a password (2FA).
# An automated loop can never complete a *new* authentication, so every blind
# reconnect gets past the pubkey factor and then fails at the password step.
# Each of those failed auths is a fail2ban strike; enough of them and the
# gateway REJECTs the source IP ("Connection refused") — the periodic "ban".
#
# The fix is to NEVER let automation open a new connection. A human establishes
# one multiplexed master once (`tssh --connect`, typing key + password); the
# `~/.ssh/config` `ControlPersist`/keepalive settings keep it alive for hours;
# and every automated command reuses that master (zero auth). If the master is
# gone, this wrapper bails out with instructions instead of hammering the
# gateway.
#
# `ssh -O check` only inspects the LOCAL control socket — no network, no auth —
# so the guard itself can never trip fail2ban. If it reports the master alive,
# a subsequent `ssh <host> <cmd>` attaches to that master and does NOT dial the
# gateway; the only path that opens a fresh connection is a missing socket,
# which the check has already ruled out.
#
# ── Usage ────────────────────────────────────────────────────────────────────
#   tssh <remote command…>         run a command on the cluster (reuse master;
#                                  bail if the master is down)
#   tssh --put <local> <remote>    scp a file to the cluster, reusing the master
#   tssh --connect                 establish/refresh the persistent master
#                                  (interactive — you enter key + password)
#   tssh --check                   report master status (exit 0 alive, 1 down)
#
# Host defaults to `triton1` (jumps via brute, the reliable gateway). Override
# with TSSH_HOST=triton if needed. Because both aliases share one control
# socket, the choice only matters when a *new* master must be created.
set -euo pipefail

HOST="${TSSH_HOST:-triton1}"
SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"

die_no_master() {
    {
        echo "tssh: no live SSH master for '$HOST' — refusing to open a new"
        echo "      connection. Automated 2FA reconnects fail at the password"
        echo "      step, and each failure is a fail2ban strike that bans your IP"
        echo "      at the gateway."
        echo
        echo "  Re-establish it yourself (you must type key + password):"
        echo "      $SELF --connect"
    } >&2
    exit 3
}

# Reuse-only guard: succeed iff a live master exists (no network, no auth).
have_master() { ssh -O check "$HOST" >/dev/null 2>&1; }

case "${1:-}" in
    --connect|up)
        # Foreground so a human can enter key + password; -f backgrounds ssh
        # after auth; ControlPersist (from ~/.ssh/config) then holds the master
        # open for hours. -N = no remote command, just the tunnel/master.
        echo "tssh: establishing persistent master to '$HOST' (enter key + password)…" >&2
        exec ssh -fN "$HOST"
        ;;

    --check|status)
        if have_master; then
            echo "tssh: master ALIVE for '$HOST' (reuse is free)" >&2
            exit 0
        else
            echo "tssh: master DOWN for '$HOST' — run: $SELF --connect" >&2
            exit 1
        fi
        ;;

    --put)
        # Guarded scp: gate on the master, then copy reusing it. scp honours the
        # same ~/.ssh/config ControlPath, so no new gateway auth happens.
        shift
        [[ $# -eq 2 ]] || { echo "Usage: tssh --put <local> <remote-path>" >&2; exit 2; }
        have_master || die_no_master
        exec scp -o BatchMode=yes "$1" "$HOST:$2"
        ;;

    "" | -h | --help)
        {
            echo "Usage:"
            echo "  tssh <remote command…>       run on cluster, reusing the SSH master"
            echo "  tssh --put <local> <remote>  scp to cluster, reusing the master"
            echo "  tssh --connect               establish the persistent master (interactive)"
            echo "  tssh --check                 report master status"
        } >&2
        [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]] && exit 0 || exit 2
        ;;

    *)
        # Remote command. Gate on the local control socket first; only reuse.
        have_master || die_no_master
        # Non-interactive SSH does NOT source the login shell, so the remote
        # PATH is the bare system default (/usr/local/bin:/usr/bin:…) — ~/.local/bin
        # (where `uv` lives) and ~/bin (where `hpc` lives) are absent, which is
        # why callers otherwise need full paths. Prepend both so `uv` and `hpc`
        # resolve exactly as they do in an interactive login shell. The prefix is
        # SINGLE-quoted so $HOME/$PATH are expanded by the REMOTE shell, not here;
        # the trailing ';' lets the caller's command follow (e.g. "cd … && hpc …").
        path_prefix='export PATH="$HOME/.local/bin:$HOME/bin:$PATH"; '
        # BatchMode=yes ensures that in the rare dead-but-not-yet-reaped window
        # ssh fails fast instead of prompting for / retrying the password. "$*"
        # joins the args with a single space — identical to what ssh sends for
        # "$@" — so the remote sees `<prefix>; <original command>`.
        exec ssh -o BatchMode=yes -o ConnectTimeout=15 "$HOST" "${path_prefix}$*"
        ;;
esac
